# Local TimescaleDB for development; change this password before deployment.
POSTGRES_PASSWORD=change-this-local-development-password
DATABASE_URL=postgresql://missionpulse:change-this-local-development-password@localhost:5432/missionpulse

# For Tiger Data, use the private connection URL from your Tiger Data project.
# Keep real credentials in this ignored .env file only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
